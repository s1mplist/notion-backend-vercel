# Notion API Configuration
NOTION_TOKEN=""
NOTION_OUTPUT_DATABASE_ID=""
NOTION_FACT_DATABASE_ID=""
NOTION_TALHOES_DATABASE_ID=""

# Logging Configuration
LOG_LEVEL="DEBUG"
ENABLE_HTML_AUDIT="true"
HTML_AUDIT_MAX_CHARS="10000"

# API Configuration
API_TITLE="Notion Backend API"
API_DESCRIPTION="API para processamento de webhooks do Notion e geração de relatórios PDF"
API_VERSION="1.0.0"

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Vercel Blob Configuration (for file storage)
BLOB_READ_WRITE_TOKEN=""

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_ENDPOINT="/metrics"
