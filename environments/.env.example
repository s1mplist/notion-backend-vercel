# Notion API Configuration
NOTION_TOKEN="your_notion_token_here"
NOTION_OUTPUT_DATABASE_ID="optional_database_id_for_storing_records"

# Logging Configuration
LOG_LEVEL="DEBUG"  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
ENABLE_HTML_AUDIT="true"  # Enable HTML audit logging
HTML_AUDIT_MAX_CHARS="10000"  # Maximum characters to log for HTML content

# API Configuration
API_TITLE="Notion Backend API"
API_DESCRIPTION="API para processamento de webhooks do Notion e geração de relatórios PDF"
API_VERSION="1.0.0"

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS=100  # Maximum requests per window
RATE_LIMIT_WINDOW=60     # Rate limit window in seconds

# PDF Generation Configuration
PDF_PROVIDER="disabled"  # Options: bannerbear, pdfshift, disabled
PDF_API_KEY=""          # API key for PDF service (required if PDF_PROVIDER != disabled)

# Vercel Blob Configuration (for file storage)
BLOB_READ_WRITE_TOKEN=""  # Vercel Blob storage token

# Monitoring Configuration
ENABLE_METRICS=true      # Enable metrics collection
METRICS_ENDPOINT="/metrics"  # Metrics endpoint path