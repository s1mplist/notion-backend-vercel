# VCS and editor
.git/
.github/
.vscode/
.idea/
.DS_Store

# Vercel internal
.vercel/

# Python caches
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
*.log

# Notebooks and related caches
notebooks/
**/.ipynb_checkpoints/
*.ipynb

# Local env and secrets (handled by Vercel env vars)
environments/
*.env
.env*

# Test and scripts
reports/
tests/
*.md
LOGGING_GUIDE.md
VERCEL_DEPLOY.md

# Logs and temporary outputs
logs/
*.bak
*.tmp

# Node/Playwright caches if they appear
node_modules/
.cache/
.playwright/
ms-playwright/

# Development files not required at runtime
pyproject.toml
requirements-dev.txt
