{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "python@3.12",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "build": {
    "env": {
      "PYTHONPATH": "./src"
    }
  }
}
