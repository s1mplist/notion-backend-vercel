{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/api/generate-pdf.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    { "src": "/api/generate-pdf", "dest": "api/generate-pdf.js" },
    { "src": "/(.*)", "dest": "src/main.py" }
  ],
  "env": {
    "PYTHONPATH": "src"
  }
}