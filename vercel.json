{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/generate-pdf.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/generate-pdf",
      "dest": "frontend/generate-pdf.js"
    },
    {
      "src": "/(.*)",
      "dest": "backend/src/main.py"
    }
  ],
  "env": {
    "PYTHONPATH": "backend/src"
  }
}